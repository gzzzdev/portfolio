    "memberId": null,
    "authorName": "방문자31",
    "guestName": "방문자31",
    "guestPassword": "0000",
    "body": "통화 일정을 저녁으로 잡아 주셔서 고마웠습니다.",
    "createdAt": "2026-06-06T04:17:24.000Z",
